{
  "name": "ogreforge-share",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:local": "node -e \"process.env.SHARE_URL='http://localhost:8080/share/';require('child_process').spawn(require('electron'),['.'],{stdio:'inherit'})\""
